{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/shared/artifacts/artifactRuntime.ts",
        "src/extensions/*/{main,panel}.ts",
        "src/extensions/*/panel.css",
        "scripts/*.mjs",
        "marketplace/*.mjs",
        "e2e/**/*.{spec,bench}.ts",
        "e2e/failed-report/*.ts",
        "test/fixtures/**/*.{mjs,js,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.mjs",
        "marketplace/**/*.{mjs,ts}",
        "test/**/*.{ts,tsx,mjs}",
        "e2e/**/*.ts"
      ],
      "ignore": [
        "src/renderer/components/ui/**"
      ],
      "ignoreDependencies": [
        "@novnc/novnc",
        "@withfig/autocomplete",
        "bash-language-server",
        "d3",
        "lucide-react",
        "pyright",
        "recharts",
        "typescript-language-server",
        "yaml-language-server"
      ]
    },
    "packages/extension-sdk": {
      "entry": [
        "src/client/{index,panel,splitter}.ts",
        "src/cli/{sdkCliEntry,manifestSchema}.ts",
        "src/contract/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/*.mjs"
      ]
    }
  },
  "ignoreBinaries": [
    "busctl",
    "hdiutil",
    "infocmp",
    "jq",
    "locale",
    "mkfifo",
    "openssl",
    "osascript",
    "script",
    "shellcheck",
    "ss",
    "ssh-agent",
    "ssh-keygen"
  ]
}

{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "src/shared/artifacts/artifactRuntime.ts",
        "src/extensions/*/{main,panel}.ts",
        "src/extensions/*/*.worker.ts",
        "src/extensions/*/*.script.ts",
        "src/extensions/*/*.thread.ts",
        "src/extensions/csv/table.ts",
        "src/extensions/images/image.ts",
        "src/extensions/video/player.ts",
        "src/extensions/markdown/preview.ts",
        "src/extensions/office/{sheet,document}.ts",
        "src/extensions/pdf/pdf.ts",
        "src/extensions/pdf/assets/pdf.css",
        "src/extensions/*/panel.css",
        "scripts/*.mjs",
        "marketplace/*.mjs",
        "e2e/**/*.{spec,bench}.ts",
        "test/*.bench.ts",
        "e2e/failed-report/*.ts",
        "test/fixtures/**/*.{mjs,js,ts}"
      ],
      "project": [
        "src/**/*.{ts,tsx,css}",
        "scripts/**/*.mjs",
        "marketplace/**/*.{mjs,ts}",
        "test/**/*.{ts,tsx,mjs}",
        "e2e/**/*.ts"
      ],
      "ignore": [
        "src/renderer/components/ui/**"
      ],
      "ignoreDependencies": [
        "@novnc/novnc",
        "@withfig/autocomplete",
        "bash-language-server",
        "buffer",
        "d3",
        "events",
        "lucide-react",
        "pyright",
        "recharts",
        "sql.js",
        "stream-browserify",
        "typescript-language-server",
        "yaml-language-server"
      ]
    },
    "packages/extension-sdk": {
      "entry": [
        "src/client/{index,panel,splitter,atomicWrite}.ts",
        "src/manifest/{sdkCliEntry,manifestSchema}.ts",
        "src/contract/*.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/*.mjs"
      ],
      "includeEntryExports": true,
      "ignoreIssues": {
        "src/{client,assist,contract}/*.ts": [
          "exports",
          "types"
        ],
        "src/manifest/manifestSchema.ts": [
          "exports"
        ]
      }
    }
  },
  "ignoreBinaries": [
    "busctl",
    "hdiutil",
    "infocmp",
    "jq",
    "locale",
    "mkfifo",
    "openssl",
    "osascript",
    "script",
    "shellcheck",
    "ss",
    "ssh-agent",
    "ssh-keygen"
  ]
}

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@shared/*": ["src/shared/*"],
      "@aurigax-ai/pine-extension-sdk": ["src/extensions/sdk/index.ts"],
      "@aurigax-ai/pine-extension-sdk/panel": ["src/extensions/sdk/panel.ts"]
    }
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/extensions/**/panel.ts"]
}

{
  "name": "ostia",
  "version": "0.5.13-rc.2",
  "description": "Terminal Workspace — the ultimate CLI workspace (terminal + IDE + agents)",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "bin": {
    "ostia": "./out/cli/index.js"
  },
  "author": "",
  "packageManager": "pnpm@11.25.0",
  "license": "FSL-1.1-MIT",
  "scripts": {
    "dev": "pnpm run build:cli && pnpm run build:sandbox-host && pnpm run build:redaction-worker && pnpm run build:history-worker && electron-vite dev",
    "build": "electron-vite build && pnpm run build:cli && pnpm run build:tsnet && pnpm run build:sandbox-host && pnpm run build:redaction-worker && pnpm run build:history-worker && pnpm run build:extensions && pnpm run build:sdk && pnpm run build:marketplace && pnpm run build:artifact-runtime && node scripts/build-info.mjs",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --external:commander --external:vscode-jsonrpc --outfile=out/cli/index.js",
    "build:tsnet": "node scripts/build-tsnet.mjs",
    "build:redaction-worker": "esbuild src/main/privacy/redactionWorker.ts --bundle --platform=node --format=cjs --outfile=out/redaction/worker.js",
    "build:history-worker": "esbuild src/main/terminal/history/spillWorker.ts --bundle --platform=node --format=cjs --outfile=out/history/worker.js",
    "build:sandbox-host": "esbuild src/main/sandbox/host.ts --bundle --platform=node --format=esm --external:@anthropic-ai/sandbox-runtime --outfile=out/sandbox/host.mjs",
    "build:extensions": "node scripts/build-extensions.mjs",
    "build:sdk": "node packages/extension-sdk/scripts/build.mjs",
    "build:marketplace": "node scripts/build-marketplace.mjs",
    "build:artifact-runtime": "node scripts/build-artifact-runtime.mjs",
    "api:bump": "node scripts/api-bump.mjs",
    "ext:release": "node scripts/extensionRelease.mjs tag",
    "publish:marketplace": "node packages/extension-sdk/scripts/build.mjs && node scripts/build-marketplace.mjs && node scripts/publish-marketplace.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "pnpm build && electron-builder",
    "icons": "bash scripts/icons.sh",
    "install:local": "OSTIA_LOCAL_INSTALL=1 pnpm package && bash scripts/install-linux.sh",
    "bump": "bash -c 'case \"$*\" in patch|minor|major) exec pnpm version --no-git-tag-version --no-git-checks \"$1\" ;; *) echo \"usage: pnpm bump <patch|minor|major>\" >&2; exit 1 ;; esac' bump",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p packages/extension-sdk",
    "rebuild": "electron-rebuild -f -w node-pty",
    "lint": "biome check src packages && node scripts/comments.mjs --check",
    "quality": "knip && depcruise src e2e test scripts packages marketplace --config .dependency-cruiser.json --ignore-known && depcruise src/renderer --config .dependency-cruiser-launch.json && jscpd && node scripts/i18n.mjs check",
    "i18n:coverage": "node scripts/i18n.mjs coverage",
    "format": "biome format --write src packages",
    "test": "vitest run --project node --project dom",
    "test:watch": "vitest --project node --project dom",
    "test:coverage": "vitest run --project node --project dom --coverage",
    "test:unit": "vitest run --project node",
    "test:dom": "vitest run --project dom",
    "test:e2e": "bash scripts/e2e.sh",
    "bench:terminal": "OSTIA_E2E_BENCH=1 bash scripts/e2e.sh --workers=1",
    "bench:flows": "rm -rf bench-results/flows/latest; OSTIA_E2E_BENCH=flows bash scripts/e2e.sh --workers=1 e2e/flows; node scripts/flowsReport.mjs",
    "bench:agent-tokens": "node scripts/agentTokens.mjs",
    "postinstall": "install-electron"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@aurigax-ai/wire": "0.1.15",
    "@noble/hashes": "^2.4.0",
    "@xterm/headless": "^6.0.0",
    "bonjour-service": "^1.4.4",
    "commander": "^14.0.3",
    "electron-log": "^5.4.4",
    "es-toolkit": "^1.52.0",
    "esbuild": "catalog:",
    "koffi": "^3.3.3",
    "lru-cache": "^11.5.3",
    "material-icon-theme": "5.40.0",
    "node-pty": "^1.1.0",
    "parse5": "^8.0.1",
    "picomatch": "^4.0.7",
    "proper-lockfile": "4.1.2",
    "selfsigned": "^5.5.0",
    "tar": "7.5.22",
    "vscode-jsonrpc": "catalog:",
    "ws": "^8.21.2",
    "yaml": "catalog:",
    "yauzl": "3.4.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk-tool/parser": "catalog:",

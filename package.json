    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@electron/rebuild": "^4.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@napi-rs/lzma": "1.5.1",
    "@novnc/novnc": "1.7.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@phosphor-icons/core": "catalog:",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.62.1",
    "@secretlint/core": "^13.0.6",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/culori": "^4.0.1",
    "@types/jsdom": "^28.0.3",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/picomatch": "^4.0.3",
    "@types/proper-lockfile": "^4.1.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/semver": "catalog:",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.0.4",
    "@withfig/autocomplete": "^2.692.3",
    "@xterm/addon-fit": "0.12.0-beta.301",

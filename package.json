{
  "name": "pine",
  "version": "0.0.4",
  "description": "Terminal Workspace — the ultimate CLI workspace (terminal + IDE + agents)",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "bin": {
    "pine": "./out/cli/index.js"
  },
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && pnpm run build:cli && pnpm run build:extensions && node scripts/build-info.mjs",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=out/cli/index.js",
    "build:extensions": "node scripts/build-extensions.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "pnpm build && electron-builder",
    "icons": "bash scripts/icons.sh",
    "install:local": "pnpm package && bash scripts/install-linux.sh",
    "bump": "node scripts/bump-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "lint": "biome check src && node scripts/comments.mjs --check",
    "format": "biome format --write src",
    "test": "vitest run --project node --project dom",
    "test:watch": "vitest --project node --project dom",
    "test:coverage": "vitest run --project node --project dom --coverage",
    "test:unit": "vitest run --project node",
    "test:security": "vitest run --project security",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "monaco-editor": "^0.55.1",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.7",
    "qrcode": "^1.5.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "selfsigned": "^5.5.0",
    "tailwind-merge": "^3.6.0",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-protocol": "^3.18.2",
    "ws": "^8.21.2",
    "yaml": "^2.9.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron/rebuild": "^4.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^22.20.1",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@withfig/autocomplete": "^2.692.3",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}

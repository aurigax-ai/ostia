    "@xterm/xterm": "6.1.0-beta.304",
    "ai": "catalog:",
    "allotment": "^1.20.5",
    "bash-language-server": "5.8.1",
    "buffer": "^6.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "d3": "^7.9.0",
    "dependency-cruiser": "^18.6.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "events": "^3.3.0",
    "fflate": "^0.8.3",
    "jscpd": "^5.4.1",
    "jsdom": "^29.1.1",
    "knip": "^6.41.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mermaid": "^12.2.0",
    "micromark-extension-gfm": "3.0.0",
    "monaco-editor": "^0.57.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.3.289",
    "pyright": "1.1.414",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "semver": "catalog:",
    "shadcn": "^4.16.1",
    "sql.js": "1.15.1",
    "stream-browserify": "^3.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "catalog:",

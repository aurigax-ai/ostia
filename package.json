{
  "name": "ostia",
  "version": "0.5.7",
  "description": "Terminal Workspace — the ultimate CLI workspace (terminal + IDE + agents)",
  "private": true,
  "type": "commonjs",
  "main": "./out/main/index.js",
  "bin": {
    "ostia": "./out/cli/index.js"
  },
  "author": "",
  "packageManager": "pnpm@11.10.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm run build:sandbox-host && pnpm run build:redaction-worker && electron-vite dev",
    "build": "electron-vite build && pnpm run build:cli && pnpm run build:sandbox-host && pnpm run build:redaction-worker && pnpm run build:extensions && pnpm run build:sdk && pnpm run build:marketplace && node scripts/build-info.mjs",
    "build:cli": "esbuild src/cli/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=out/cli/index.js",
    "build:redaction-worker": "esbuild src/main/redactionWorker.ts --bundle --platform=node --format=cjs --outfile=out/redaction/worker.js",
    "build:sandbox-host": "esbuild src/main/sandbox/host.ts --bundle --platform=node --format=esm --packages=external --outfile=out/sandbox/host.mjs",
    "build:extensions": "node scripts/build-extensions.mjs",
    "build:sdk": "node scripts/build-sdk.mjs",
    "build:marketplace": "node scripts/build-marketplace.mjs",
    "api:bump": "node scripts/api-bump.mjs",
    "publish:marketplace": "node scripts/build-sdk.mjs && node scripts/build-marketplace.mjs && node scripts/publish-marketplace.mjs",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "package": "pnpm build && electron-builder",
    "icons": "bash scripts/icons.sh",
    "install:local": "pnpm package && bash scripts/install-linux.sh",
    "bump": "node scripts/bump-version.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "rebuild": "electron-rebuild -f -w node-pty",
    "lint": "biome check src && node scripts/comments.mjs --check",
    "format": "biome format --write src",
    "test": "vitest run --project node --project dom",
    "test:watch": "vitest --project node --project dom",
    "test:coverage": "vitest run --project node --project dom --coverage",
    "test:unit": "vitest run --project node",
    "test:security": "vitest run --project security",
    "test:e2e": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.78",
    "@xterm/headless": "^6.0.0",
    "commander": "^14.0.3",
    "electron-log": "^5.4.4",
    "es-toolkit": "^1.52.0",
    "lru-cache": "^11.5.3",
    "node-pty": "^1.1.0",
    "picomatch": "^4.0.7",
    "selfsigned": "^5.5.0",
    "tar": "7.5.22",
    "vscode-jsonrpc": "^9.0.1",
    "ws": "^8.21.2",
    "yaml": "^2.9.1",
    "yauzl": "3.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk-tool/parser": "^5.1.6",
    "@ai-sdk/anthropic": "^4.0.68",
    "@ai-sdk/mcp": "~2.0.62",
    "@ai-sdk/openai": "^4.0.81",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@ai-sdk/react": "^4.0.125",
    "@base-ui/react": "^1.7.0",
    "@biomejs/biome": "^1.9.4",
    "@electron/rebuild": "^4.2.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@phosphor-icons/core": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/test": "^1.62.1",
    "@secretlint/core": "^13.0.6",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.1",
    "@types/picomatch": "^4.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/ws": "^8.18.1",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@withfig/autocomplete": "^2.692.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^7.0.122",
    "allotment": "^1.20.5",
    "bash-language-server": "5.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "culori": "^4.0.2",
    "diff": "^9.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^6.3.289",
    "pyright": "1.1.414",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "semver": "^7.8.5",
    "shadcn": "^4.16.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "undici": "^6.28.0",
    "use-stick-to-bottom": "^1.1.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "vscode-languageserver-protocol": "^3.18.2",
    "yaml-language-server": "1.24.0",
    "zustand": "^4.5.7"
  }
}

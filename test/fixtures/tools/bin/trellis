#!/usr/bin/env node
const fs = require('node:fs')
const path = require('node:path')

const dir = process.env.FAKE_TRELLIS_DIR
if (!dir) {
  process.stderr.write('FAKE_TRELLIS_DIR is not set\n')
  process.exit(2)
}
const argv = process.argv.slice(2)
fs.appendFileSync(path.join(dir, 'calls.log'), `${argv.join(' ')}\n`)

const VALUE_FLAGS = new Set([
  'project',
  'board',
  'title',
  'body',
  'column',
  'priority',
  'label',
  'consumer',
  'limit',
  'ttl',
  'after',
  'as',
])

function parse(args) {
  const flags = {}
  const bools = new Set()
  const rest = []
  for (let i = 0; i < args.length; i++) {
    const arg = args[i]
    if (!arg.startsWith('--')) {
      rest.push(arg)
      continue
    }
    const eq = arg.indexOf('=')
    const name = eq === -1 ? arg.slice(2) : arg.slice(2, eq)
    if (eq !== -1) flags[name] = arg.slice(eq + 1)
    else if (VALUE_FLAGS.has(name) && i + 1 < args.length) flags[name] = args[++i]
    else bools.add(name)
  }
  return { flags, bools, rest }
}

function file(name) {
  return path.join(dir, name)
}

function read(name) {
  return fs.readFileSync(file(name), 'utf8')
}

function out(value) {
  process.stdout.write(`${typeof value === 'string' ? value : JSON.stringify(value)}\n`)
}

function fail(code, message, exit, fix) {
  const error = fix ? { code, message, fix } : { code, message }
  process.stderr.write(`${JSON.stringify({ error })}\n`)
  process.exit(exit)
}

function failWith(name, exit) {
  process.stderr.write(read(name))
  process.exit(exit)
}

function text(value) {
  if (value === undefined) return undefined
  if (value === '-') return fs.readFileSync(0, 'utf8')
  if (value.startsWith('@')) return fs.readFileSync(value.slice(1), 'utf8')
  return value
}

function initialState() {
  const board = JSON.parse(read('board.json'))
  for (const column of board.columns) {
    for (const c of column.cards) if (c.claim_until) c.claim_until = Date.now() + 30 * 60_000
  }
  const details = {}
  const comments = {}
  for (const name of fs.readdirSync(dir)) {
    const card = /^card-([A-Z0-9-]+)\.json$/.exec(name)
    if (card) {
      const shown = JSON.parse(read(name))
      details[card[1]] = { relations: shown.relations, blocked_by: shown.blocked_by }
    }
    const http = /^http-card-([A-Z0-9-]+)\.json$/.exec(name)
    if (http) comments[http[1]] = JSON.parse(read(name)).comments ?? []
  }
  return { board, details, comments, next: 100 }
}

function loadState() {
  if (!fs.existsSync(file('state.json'))) saveState(initialState())
  return JSON.parse(read('state.json'))
}

function saveState(state) {
  const staging = file(`state.json.${process.pid}.tmp`)
  fs.writeFileSync(staging, JSON.stringify(state))
  fs.renameSync(staging, file('state.json'))
}

function allCards(state) {
  return state.board.columns.flatMap((c) => c.cards)
}

function findCard(state, ref) {
  return allCards(state).find((c) => c.ref === ref)
}

function checkProject(state, flags) {
  if (flags.project && flags.project !== state.board.project) {
    failWith('error-project-not-found.json', 3)
  }
}

function actor() {
  return process.env.TRELLIS_AGENT || `cli:${process.pid}`
}

function cardOrFail(state, ref) {
  const card = findCard(state, ref)
  if (!card) fail('card_not_found', `no card ${ref}`, 3, 'trellis card ls')
  return card
}

function column(state, name) {
  return state.board.columns.find((c) => c.name === name)
}

function moveCard(state, card, to) {
  const target = column(state, to)
  if (!target) {
    const have = state.board.columns.map((c) => c.name).join(', ')
    fail('column_not_found', `no column "${to}" (have: ${have})`, 3, 'trellis column ls')
  }
  for (const c of state.board.columns) c.cards = c.cards.filter((x) => x.ref !== card.ref)
  card.column = to
  card.version += 1
  card.updated_at = Date.now()
  if (target.done) {
    card.claimed_by = undefined
    card.claim_until = undefined
  }
  target.cards.push(card)
}

function card(args) {
  const { flags, rest } = parse(args.slice(1))
  const state = loadState()
  checkProject(state, flags)
  const verb = args[0]
  const ref = rest[0]
  if (verb === 'show') {
    const found = cardOrFail(state, ref)
    return out({ ...found, ...(state.details[ref] ?? {}) })
  }
  if (verb === 'new') {
    const title = text(flags.title) ?? ''
    if (!title.trim()) fail('invalid_input', 'a card needs a title', 2)
    const target = flags.column ?? state.board.columns[0].name
    const number = Math.max(0, ...allCards(state).map((c) => Number(c.ref.split('-').pop()))) + 1
    const created = {
      id: `fake-${number}`,
      title,
      body: text(flags.body) ?? '',
      version: 1,
      created_at: Date.now(),
      updated_at: Date.now(),
      ref: `${state.board.project}-${number}`,
      column: target,
      priority: flags.priority ?? 'normal',
    }
    const into = column(state, target)
    if (!into) fail('column_not_found', `no column "${target}"`, 3, 'trellis column ls')
    into.cards.push(created)
    saveState(state)
    return out(created)
  }
  const found = cardOrFail(state, ref)
  if (verb === 'move') {
    moveCard(state, found, flags.column ?? rest[1])
    saveState(state)
    return out(found)
  }
  if (verb === 'comment') {
    const comment = {
      id: `comment-${state.next++}`,
      card_id: found.id,
      actor: actor(),
      body: text(flags.body) ?? '',
      created_at: Date.now(),
    }
    state.comments[ref] = [...(state.comments[ref] ?? []), comment]
    saveState(state)
    return out(comment)
  }
  const live = found.claimed_by && (found.claim_until ?? 0) > Date.now()
  if (verb === 'claim') {
    if (live && found.claimed_by !== actor()) {
      fail('contention', `card claimed by ${found.claimed_by} (last seen 0s ago)`, 4)
    }
    found.claimed_by = actor()
    found.claim_until = Date.now() + Number(flags.ttl ?? 30) * 60_000
    found.version += 1
    saveState(state)
    return out(found)
  }
  if (verb === 'renew' || verb === 'release') {
    if (!live || found.claimed_by !== actor()) {
      fail('not_yours', `you do not claim ${ref}`, 4, `trellis card claim ${ref}`)
    }
    if (verb === 'renew') found.claim_until = Date.now() + 30 * 60_000
    else {
      found.claimed_by = undefined
      found.claim_until = undefined
    }
    saveState(state)
    return out(verb === 'renew' ? { renewed: ref } : { released: ref })
  }
  fail('fake_unknown', 'unexpected call', 3)
}

function vault(args) {
  const { flags, rest } = parse(args.slice(1))
  const state = loadState()
  checkProject(state, flags)
  if (args[0] === 'ls') return out(read('vault-ls.json').trim())
  if (args[0] === 'show') {
    const name = `vault-${String(rest[0]).replaceAll('/', '__')}.json`
    if (!/^[a-z0-9_-]+\.json$/.test(name.slice(6)) || !fs.existsSync(file(name))) {
      failWith('error-entry-not-found.json', 3)
    }
    return out(read(name).trim())
  }
  fail('fake_unknown', 'unexpected call', 3)
}

function follow() {
  if (fs.existsSync(file('follow-exits'))) process.exit(1)
  let offset = 0
  let pending = ''
  const pump = () => {
    let data = ''
    try {
      const all = fs.readFileSync(file('follow.jsonl'))
      data = all.subarray(offset).toString('utf8')
      offset = all.length
    } catch {}
    pending += data
    const end = pending.lastIndexOf('\n')
    if (end >= 0) {
      process.stdout.write(pending.slice(0, end + 1))
      pending = pending.slice(end + 1)
    }
  }
  pump()
  setInterval(pump, 50)
  for (const signal of ['SIGTERM', 'SIGINT']) process.on(signal, () => process.exit(0))
}

function events(args) {
  const { bools } = parse(args)
  if (args[0] === 'consumers') {
    return out(fs.existsSync(file('consumers.json')) ? read('consumers.json').trim() : '[]')
  }
  if (args[0] === 'ack') return out({ name: args[1], cursor: Number(args[2]) })
  if (bools.has('follow')) return follow()
  if (fs.existsSync(file('prime.jsonl'))) process.stdout.write(read('prime.jsonl'))
}

const [noun, ...tail] = argv
const { flags, bools } = parse(argv)
if (noun === 'version') out(read('version.json').trim())
else if (noun === 'daemon' && tail[0] === 'status') {
  const up = fs.existsSync(file('daemon-up'))
  out(read(up ? 'daemon-running.json' : 'daemon-stopped.json').trim())
} else if (noun === 'init') {
  fs.writeFileSync(file('init-cwd'), `${process.cwd()}\n`)
  out(read('init.json').trim())
} else if (noun === 'project' && tail[0] === 'ls') out(read('projects.json').trim())
else if (noun === 'board' && tail[0] === 'ls') {
  checkProject(loadState(), flags)
  out(read('boards.json').trim())
} else if (noun === 'board' && tail[0] === 'show') {
  const state = loadState()
  checkProject(state, flags)
  out(state.board)
} else if (noun === 'card') card(tail)
else if (noun === 'vault') vault(tail)
else if (noun === 'events') events(tail)
else if (bools.has('help')) out('help')
else fail('fake_unknown', 'unexpected call', 3)

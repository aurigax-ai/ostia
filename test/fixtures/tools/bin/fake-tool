#!/usr/bin/env node
const { spawn } = require('node:child_process')
const fs = require('node:fs')

const [command, ...args] = process.argv.slice(2)

if (command === 'env') {
  for (const [name, value] of Object.entries(process.env)) console.log(`${name}=${value}`)
} else if (command === 'status') {
  console.log('check one: pass')
  console.log('check two: pending')
  console.log('check three: fail')
  process.exit(3)
} else if (command === 'argv') {
  console.log(JSON.stringify(args))
} else if (command === 'big') {
  process.stdout.write('x'.repeat(200 * 1024))
} else if (command === 'sleep') {
  setTimeout(() => {}, Number(args[0] ?? 60) * 1000)
} else if (command === 'sleep-child') {
  const child = spawn(process.execPath, ['-e', 'setTimeout(() => {}, 600000)'], { stdio: 'ignore' })
  if (args[0]) fs.writeFileSync(args[0], `${process.pid} ${child.pid}\n`)
  setTimeout(() => {}, 600000)
} else if (command === 'fail-times') {
  const file = args[0]
  const times = Number(args[1] ?? 1)
  const seen = fs.existsSync(file) ? Number(fs.readFileSync(file, 'utf8')) : 0
  fs.writeFileSync(file, String(seen + 1))
  console.log(`attempt ${process.env.GRAPH_ATTEMPT ?? ''} key ${process.env.GRAPH_ATTEMPT_KEY ?? ''}`)
  process.exit(seen < times ? 1 : 0)
} else if (command === 'visit-log') {
  const env = process.env
  fs.appendFileSync(args[0], `${env.GRAPH_RUN_ID} ${env.GRAPH_NODE} ${env.GRAPH_ATTEMPT_KEY} ${env.GRAPH_ATTEMPT}\n`)
  const failing = env.GRAPH_ATTEMPT_KEY?.endsWith(`:${args[1]}`) && env.GRAPH_ATTEMPT === '1'
  process.exit(failing ? 1 : 0)
} else if (command === 'read') {
  process.stdout.write(fs.readFileSync(args[0], 'utf8'))
} else if (command === 'write') {
  fs.writeFileSync(args[0], args[1] ?? '')
} else {
  console.error(`fake-tool: unknown command ${command}`)
  process.exit(2)
}

{
  "id": "oracle",
  "name": "Oracle",
  "version": "0.1.0",
  "api": "3.0",
  "description": "Test fixture for the assist contribution points",
  "capabilities": ["assist"],
  "main": "main.js",
  "contributes": {
    "commands": [
      {
        "id": "secret",
        "title": "Read the api key",
        "palette": false
      },
      {
        "id": "events",
        "title": "Count settings events",
        "palette": false
      },
      {
        "id": "status",
        "title": "Set assist status",
        "palette": false
      },
      {
        "id": "shortcuts",
        "title": "Read shortcuts",
        "palette": false
      },
      {
        "id": "openui",
        "title": "Open assist UI",
        "palette": false
      }
    ],
    "assist": ["chat", "command", "input", "terminal"],
    "secrets": {
      "apiKey": {
        "description": "Key for the fake provider"
      }
    },
    "settings": {
      "chat": {
        "type": "boolean",
        "default": true,
        "description": "Chat on"
      },
      "level": {
        "type": "number",
        "default": 1,
        "description": "Not a switch"
      }
    }
  }
}

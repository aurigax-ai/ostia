{
  "id": "hello",
  "name": "Hello",
  "version": "0.1.0",
  "api": "1.7",
  "description": "E2E fixture: a user extension with a palette command, CLI commands, a file panel, a pane chip and a setting",
  "capabilities": ["notify"],
  "main": "main.js",
  "locales": ["zh-Hant"],
  "contributes": {
    "commands": [
      { "id": "open", "title": "Hello: Open Panel", "category": "Hello" },
      { "id": "greet", "title": "Greet someone", "usage": "greet <name>", "palette": false },
      { "id": "chip", "title": "Put a chip on this pane", "usage": "chip", "palette": false },
      { "id": "card", "title": "Open the card page", "usage": "card", "palette": false }
    ],
    "sidebarItems": true,
    "panel": { "title": "Hello", "entry": "panel.html" },
    "paneChips": [{ "id": "greeting", "title": "Greeting" }],
    "settings": {
      "greeting": { "type": "string", "default": "hello", "description": "The word used to greet" }
    }
  }
}

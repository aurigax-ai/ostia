{
  "id": "switchboard",
  "name": "Switchboard",
  "version": "0.1.0",
  "api": "3.0",
  "description": "Test fixture for an assist extension with several providers and models",
  "capabilities": ["assist"],
  "main": "main.js",
  "contributes": {
    "commands": [
      {
        "id": "entries",
        "title": "Read the providers this extension was given",
        "palette": false
      }
    ],
    "assist": ["chat", "command"],
    "settings": {
      "chat": {
        "type": "boolean",
        "default": true,
        "description": "Chat on"
      }
    }
  }
}

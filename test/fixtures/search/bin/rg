#!/usr/bin/env node
const fs = require('node:fs')

const argv = process.argv.slice(2)
if (process.env.FAKE_RG_LOG) {
  fs.appendFileSync(process.env.FAKE_RG_LOG, `${JSON.stringify({ cwd: process.cwd(), argv })}\n`)
}

if (argv.includes('--files')) {
  process.stdout.write('./README.md\n./src/FileView.tsx\n./src/main.ts\n')
  process.exit(0)
}

const text = argv[argv.indexOf('--') + 1]
if (!argv.includes('--fixed-strings') && text.includes('(')) {
  process.stderr.write('rg: regex parse error:\n    (?:bad()\n    ^\nerror: unclosed group\n')
  process.exit(2)
}
if (text === 'absent') process.exit(1)

const line = `const ${text} = 1\n`
const start = Buffer.byteLength('const ')
const events = [
  { type: 'begin', data: { path: { text: './src/main.ts' } } },
  {
    type: 'match',
    data: {
      path: { text: './src/main.ts' },
      lines: { text: line },
      line_number: 3,
      absolute_offset: 0,
      submatches: [{ match: { text }, start, end: start + Buffer.byteLength(text) }],
    },
  },
  { type: 'end', data: { path: { text: './src/main.ts' } } },
]
process.stdout.write(`${events.map((e) => JSON.stringify(e)).join('\n')}\n`)

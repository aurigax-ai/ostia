{
  "id": "linked",
  "name": "Linked",
  "version": "0.1.0",
  "api": "6.0",
  "description": "Test fixture: declares an http connection kind and reads its connections",
  "capabilities": [],
  "main": "main.js",
  "contributes": {
    "commands": [
      { "id": "call", "title": "Call a method", "palette": false, "interactive": true },
      { "id": "events", "title": "Events seen", "palette": false }
    ],
    "connections": [
      {
        "kind": "http",

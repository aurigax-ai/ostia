#!/bin/sh
if [ -n "$FAKE_SSH_LOG" ]; then printf 'ssh %s\n' "$*" >> "$FAKE_SSH_LOG"; fi
if [ "$1" = "-G" ]; then
  for last in "$@"; do :; done
  capture="${FAKE_SSH_DIR:?FAKE_SSH_DIR is not set}/${last##*@}.txt"
  if [ -f "$capture" ]; then
    cat "$capture"
    exit 0
  fi
  echo "fake ssh: Could not resolve hostname ${last##*@}" >&2
  exit 255
fi
control_path=
control_master=
control_op=
control_socket=
route=
want=
sep=
dest=
for arg in "$@"; do
  if [ -n "$sep" ] && [ -z "$dest" ]; then dest=$arg; fi
  [ "$arg" = "--" ] && sep=1
  if [ -n "$want" ]; then
    case "$want" in
      o) case "$arg" in
           ControlPath=*) control_path=${arg#ControlPath=} ;;
           ControlMaster=*) control_master=${arg#ControlMaster=} ;;
         esac ;;
      O) control_op=$arg ;;
      S) control_socket=$arg ;;
      L) control_forward=$arg ;;
      route) route="$route $arg" ;;
    esac
    want=
    continue
  fi
  case "$arg" in
    -o) want=o ;;
    -O) want=O ;;
    -S) want=S ;;
    -L) want=L ;;
    -J|-p) route="$route $arg"; want=route ;;
  esac
done
if [ -n "$control_op" ]; then
  if [ -z "$control_socket" ] && [ -n "$control_path" ]; then
    control_socket=$(printf '%s' "$control_path" | sed "s|%C|$(printf '%s %s' "$route" "$dest" | cksum | cut -d' ' -f1)|")
  fi
  case "${control_socket##*/}" in
    *.*) echo "Control socket connect($control_socket): Not a socket" >&2; exit 255 ;;
  esac
  if [ ! -e "$control_socket" ]; then
    echo "Control socket connect($control_socket): No such file or directory" >&2
    exit 255
  fi
  case "$control_op" in
    forward)
      echo "$control_forward" >> "$control_socket.forwards"
      ready="$control_socket.ready.$$"
      node "$(dirname "$0")/forward.js" "$control_forward" "$ready" > /dev/null 2>&1 < /dev/null &
      echo "$control_forward $!" >> "$control_socket.pids"
      until [ -e "$ready" ] || ! kill -0 $! 2>/dev/null; do sleep 0.02; done
      rm -f "$ready" ;;
    cancel)
      if [ -f "$control_socket.forwards" ]; then grep -vxF "$control_forward" "$control_socket.forwards" > "$control_socket.tmp"; mv "$control_socket.tmp" "$control_socket.forwards"; fi
      if [ -f "$control_socket.pids" ]; then
        while read -r spec pid; do [ "$spec" = "$control_forward" ] && kill "$pid" 2>/dev/null; done < "$control_socket.pids"
        grep -v "^$control_forward " "$control_socket.pids" > "$control_socket.tmp"; mv "$control_socket.tmp" "$control_socket.pids"
      fi ;;
    check) echo "Master running (pid=1)" ;;
    exit)
      if [ -f "$control_socket.pids" ]; then
        while read -r spec pid; do
          kill "$pid" 2>/dev/null
          while kill -0 "$pid" 2>/dev/null; do sleep 0.02; done
        done < "$control_socket.pids"
      fi
      rm -f "$control_socket" "$control_socket.forwards" "$control_socket.pids"; echo "Exit request sent." ;;
  esac
  exit 0
fi
if [ "$control_master" = auto ] && [ -n "$control_path" ]; then
  socket=$(printf '%s' "$control_path" | sed "s|%C|$(printf '%s %s' "$route" "$dest" | cksum | cut -d' ' -f1)|")
  if [ -e "$socket" ]; then
    echo "fake ssh mux client: $socket" >> "${FAKE_SSH_MUX_LOG:-/dev/null}"
  else
    : > "$socket"
    echo "fake ssh master: $socket" >> "${FAKE_SSH_MUX_LOG:-/dev/null}"
  fi
fi
previous=
for arg in "$@"; do
  if [ "$previous" = "-L" ]; then
    exec node "$(dirname "$0")/forward.js" "$arg"
  fi
  previous=$arg
done
shown=
remote=
after_separator=
destination=
for arg in "$@"; do
  if [ -n "$destination" ]; then
    remote=$arg
  elif [ -n "$after_separator" ]; then
    destination=$arg
    shown="$shown $arg"
  else
    [ "$arg" = "--" ] && after_separator=1
    shown="$shown $arg"
  fi
done
echo "fake ssh session:$shown"
if [ -n "$remote" ]; then
  echo "fake ssh remote command: yes"
  if [ -n "$FAKE_SSH_REMOTE_SHELL" ]; then
    exec env -i HOME="${FAKE_SSH_REMOTE_HOME:?FAKE_SSH_REMOTE_HOME is not set}" PATH="$PATH" TERM="$TERM" SHELL="$FAKE_SSH_REMOTE_SHELL" TMPDIR="${FAKE_SSH_REMOTE_TMP:-/tmp}" "$FAKE_SSH_REMOTE_SHELL" -c "$remote"
  fi
fi

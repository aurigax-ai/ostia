{
  "name": "@aurigax-ai/ostia-extension-sdk",
  "private": true,
  "description": "Write extensions for Ostia: the client library, its types, manifest schemas and a project generator",
  "keywords": [
    "ostia",
    "terminal",
    "extension",
    "sdk",
    "coding-agents"
  ],
  "license": "MIT",
  "exports": {
    ".": "./src/client/index.ts",
    "./assist": "./src/assist/index.ts",
    "./panel": "./src/client/panel.ts",
    "./splitter": "./src/client/splitter.ts",
    "./viewer": "./src/client/viewer.ts",
    "./browse": "./src/client/browse.ts",
    "./grid": "./src/client/grid.ts",
    "./cells": "./src/client/cells.ts",
    "./pill": "./src/client/pill.ts",
    "./slider": "./src/client/slider.ts",
    "./atomicWrite": "./src/client/atomicWrite.ts",
    "./panel.css": "./src/client/panel.css",
    "./contract/*": "./src/contract/*.ts",
    "./manifest/*": "./src/manifest/*.ts",
    "./api-contract": "./scripts/api-contract.mjs"
  },
  "dependencies": {
    "@tanstack/virtual-core": "3.19.4",
    "vscode-jsonrpc": "catalog:"
  },
  "peerDependencies": {
    "@ai-sdk-tool/parser": "catalog:",
    "ai": "catalog:",
    "undici": "catalog:",
    "zod": "catalog:"
  },
  "peerDependenciesMeta": {
    "@ai-sdk-tool/parser": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "undici": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk-tool/parser": "catalog:",
    "@types/node": "catalog:",
    "ai": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "undici": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  }
}

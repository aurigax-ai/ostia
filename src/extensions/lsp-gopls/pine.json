{
  "id": "lsp-gopls",
  "name": "Go (gopls)",
  "version": "1.0.0",
  "locales": ["zh-Hant"],
  "api": "1.17",
  "description": "Go diagnostics, completion, hover and navigation in the editor. Uses the gopls on your PATH; without one, {product} runs go install for the pinned gopls version into its own data folder. Needs Go.",
  "category": "languages",
  "capabilities": ["language-server"],
  "contributes": {
    "languageServers": [
      {
        "id": "gopls",
        "name": "gopls",
        "languages": ["go"],
        "run": {
          "goInstall": {
            "module": "golang.org/x/tools/gopls",
            "version": "v0.23.0",
            "binary": "gopls"
          },
          "args": []
        },
        "rootMarkers": ["go.work", "go.mod"]
      }
    ]
  }
}

{
  "id": "trellis",
  "name": "Trellis",
  "version": "1.3.0",
  "api": "1.6",
  "description": "Your Trellis boards and vault as a panel: cards, claims, comments and entries, updated live as they change elsewhere; open and claimed cards per workspace, and a notice that opens the card when an agent moves it to review or blocked.",
  "category": "tools",
  "capabilities": ["read-board", "notify"],
  "main": "main.js",
  "locales": ["zh-Hant"],
  "contributes": {
    "commands": [
      { "id": "open", "title": "Trellis: Open Board", "category": "Trellis" },
      {
        "id": "card",
        "title": "Trellis: Open Card",
        "category": "Trellis",
        "usage": "card <REF>",
        "argument": "Card id, for example SHOP-12"
      },
      { "id": "vault", "title": "Trellis: Open Vault", "category": "Trellis", "usage": "vault" },
      {
        "id": "init",
        "title": "Trellis: Init Project Here",
        "category": "Trellis",
        "usage": "init"
      },
      {
        "id": "status",
        "title": "Open and claimed cards for this workspace's project",
        "usage": "status",
        "palette": false,
        "capabilities": ["read-board"]
      }
    ],
    "workspaceChips": [{ "id": "cards", "title": "Trellis cards" }],
    "panel": { "title": "Trellis", "icon": "kanban", "entry": "url" },
    "settings": {
      "notifyReview": {
        "type": "boolean",
        "title": "Notify on review",
        "default": true,
        "description": "Notify when an agent moves a card to a review column"
      },
      "notifyBlocked": {
        "type": "boolean",
        "title": "Notify on blocked",
        "default": true,
        "description": "Notify when an agent moves a card to a blocked column"
      },
      "refreshSeconds": {
        "type": "number",
        "title": "Card count refresh",
        "default": 60,
        "minimum": 10,
        "maximum": 3600,
        "unit": "seconds",
        "description": "Time between card count refreshes"
      }
    }
  }
}

{
  "id": "images",
  "name": "Images",
  "version": "1.0.0",
  "api": "7.9",
  "description": "Shows .png, .jpg, .jpeg, .gif, .webp, .svg, .bmp, .ico and .avif files fitted to the pane, with zoom, a transparency grid and a crop you draw by dragging. It reads only the file you opened, draws an SVG as a picture without running it, and sends the file nowhere until you choose Send to agent.",
  "category": "tools",
  "locales": ["zh-Hant"],
  "contributes": {
    "fileKinds": [
      {
        "id": "images.image",
        "displayName": "Image",
        "selector": [
          {
            "filenamePattern": "*.png"
          },
          {
            "filenamePattern": "*.jpg"
          },
          {
            "filenamePattern": "*.jpeg"
          },
          {
            "filenamePattern": "*.gif"
          },
          {
            "filenamePattern": "*.webp"
          },
          {
            "filenamePattern": "*.svg"
          },
          {
            "filenamePattern": "*.bmp"
          },
          {
            "filenamePattern": "*.ico"
          },
          {
            "filenamePattern": "*.avif"
          }
        ],
        "view": {
          "entry": "image.html",
          "priority": "default"
        }
      }
    ]
  }
}

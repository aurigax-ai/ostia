{
  "id": "wiki",
  "name": "Wiki",
  "version": "1.0.0",
  "description": "Project and global notes shared by you and your agents.",
  "capabilities": [],
  "main": "main.js",
  "contributes": {
    "commands": [
      { "id": "open", "title": "Open Wiki", "category": "App", "capabilities": ["wiki-read"] },
      {
        "id": "get",
        "title": "Print a page's body",
        "usage": "get <slug> [--global]",
        "palette": false,
        "capabilities": ["wiki-read"]
      },
      {
        "id": "set",
        "title": "Upsert a page (body read from stdin)",
        "usage": "set <slug> [--global]",
        "palette": false,
        "stdin": true,
        "capabilities": ["wiki-write"]
      },
      {
        "id": "ls",
        "title": "List pages",
        "usage": "ls [--global]",
        "palette": false,
        "capabilities": ["wiki-read"]
      },
      {
        "id": "search",
        "title": "Search pages by title/body",
        "usage": "search <q> [--global]",
        "palette": false,
        "capabilities": ["wiki-read"]
      },
      {
        "id": "rm",
        "title": "Delete a page",
        "usage": "rm <slug> [--global]",
        "palette": false,
        "capabilities": ["wiki-write"]
      }
    ],
    "panel": { "title": "Wiki", "icon": "book-open", "entry": "url" }
  }
}

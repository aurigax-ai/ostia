{
  "id": "lsp-yaml",
  "name": "YAML",
  "version": "1.0.0",
  "locales": ["zh-Hant"],
  "api": "3.0",
  "description": "YAML validation, completion, hover and formatting in the editor. Ships yaml-language-server inside this extension and runs it with {product}'s own runtime.",
  "category": "languages",
  "capabilities": ["language-server"],
  "contributes": {
    "settings": {
      "schemaStore": {
        "type": "boolean",
        "title": "Schemas from schemastore.org",
        "default": false,
        "description": "Let the server fetch the schema catalog and matching schemas from schemastore.org, for files such as GitHub workflows or Compose files"
      }
    },
    "languageServers": [
      {
        "id": "yaml",
        "name": "yaml-language-server",
        "languages": ["yaml"],
        "run": {
          "node": "server/node_modules/yaml-language-server/out/server/src/server.js",
          "args": ["--stdio"]
        },
        "settings": {
          "yaml": {
            "validate": true,
            "hover": true,
            "completion": true,
            "format": {
              "enable": true
            },
            "schemaStore": {
              "enable": false
            }
          },
          "redhat": {
            "telemetry": {
              "enabled": false
            }
          }
        },
        "settingPaths": {
          "schemaStore": "yaml.schemaStore.enable"
        }
      }
    ]
  }
}

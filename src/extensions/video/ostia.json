{
  "id": "video",
  "name": "Video and audio",
  "version": "1.0.0",
  "api": "7.14",
  "description": "Plays video (.mp4, .m4v, .mov, .webm, .mkv) and audio (.mp3, .wav, .m4a, .ogg, .flac) files in one player with seek, volume, speed and loop controls. Drag across a paused video frame to crop it and send the picture to an agent. It reads only the file you opened, streams it in ranges and sends it nowhere.",
  "category": "tools",
  "locales": ["zh-Hant"],
  "contributes": {
    "fileKinds": [
      {
        "id": "video.video",
        "displayName": "Player",
        "selector": [
          {
            "filenamePattern": "*.mp4"
          },
          {
            "filenamePattern": "*.m4v"
          },
          {
            "filenamePattern": "*.mov"
          },
          {
            "filenamePattern": "*.webm"
          },
          {
            "filenamePattern": "*.mkv"
          },
          {
            "filenamePattern": "*.mp3"
          },
          {
            "filenamePattern": "*.wav"
          },
          {
            "filenamePattern": "*.m4a"
          },
          {
            "filenamePattern": "*.ogg"
          },
          {
            "filenamePattern": "*.flac"
          }
        ],
        "view": {
          "entry": "player.html",
          "priority": "default"
        }
      }
    ]
  }
}

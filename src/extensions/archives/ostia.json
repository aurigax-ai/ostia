{
  "id": "archives",
  "name": "Archives",
  "version": "1.0.0",
  "api": "7.3",
  "description": "Lists and opens what is inside zip, jar, tar, tar.gz, tar.zst, tar.xz, tar.bz2 and 7z files in the Files panel, read-only. It reads the archive you expand through Ostia in small blocks, never gets a path, never extracts anything to disk, never follows links and refuses encrypted entries and decompression bombs.",
  "category": "tools",
  "locales": ["zh-Hant"],
  "capabilities": ["file-contents"],
  "main": "main.js",
  "contributes": {
    "fileKinds": [
      {
        "id": "archives.zip",
        "displayName": "Zip archive",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.jar"
          }
        ],
        "browse": {}
      },
      {
        "id": "archives.tar",
        "displayName": "Tar archive",
        "selector": [
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tzst"
          },
          {
            "filenamePattern": "*.tar.zst"
          }
        ],
        "browse": {}
      },
      {
        "id": "archives.tar-xz",
        "displayName": "Tar xz archive",
        "selector": [
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.txz"
          }
        ],
        "browse": {}
      },
      {
        "id": "archives.tar-bz2",
        "displayName": "Tar bzip2 archive",
        "selector": [
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tbz"
          }
        ],
        "browse": {}
      },
      {
        "id": "archives.sevenzip",
        "displayName": "7z archive",
        "selector": [
          {
            "filenamePattern": "*.7z"
          }
        ],
        "browse": {}
      }
    ]
  }
}

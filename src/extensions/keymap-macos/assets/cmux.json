{
  "bindings": {
    "palette.toggle": "Cmd+Shift+P",
    "view.goToWorkspace": "Cmd+P",
    "view.goToFile": null,
    "view.toggleRail": "Cmd+B",
    "workspace.new": "Cmd+N",
    "tab.new": "Cmd+T",
    "pane.splitRight": "Cmd+D",
    "pane.splitDown": "Cmd+Shift+D",
    "pane.focusLeft": "Cmd+Alt+Left",
    "pane.focusRight": "Cmd+Alt+Right",
    "pane.focusUp": "Cmd+Alt+Up",
    "pane.focusDown": "Cmd+Alt+Down",
    "pane.zoom": "Cmd+Shift+Enter",
    "dashboard.toggle": "Cmd+Alt+D",
    "terminal.clear": "Cmd+Shift+K"
  }
}

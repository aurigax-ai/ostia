{
  "bindings": {
    "palette.toggle": "Cmd+Shift+P",
    "view.goToWorkspace": "Cmd+P",
    "view.goToFile": null,
    "view.toggleRail": "Cmd+B",
    "workspace.new": "Cmd+N",
    "tab.new": "Cmd+T",
    "pane.splitRight": "terminal:Cmd+D",
    "pane.splitDown": "terminal:Cmd+Shift+D",
    "pane.focusLeft": "terminal:Cmd+Alt+Left",
    "pane.focusRight": "terminal:Cmd+Alt+Right",
    "pane.focusUp": "terminal:Cmd+Alt+Up",
    "pane.focusDown": "terminal:Cmd+Alt+Down",
    "pane.zoom": "terminal:Cmd+Shift+Enter",
    "dashboard.toggle": "Cmd+Alt+D",
    "terminal.clear": ["terminal:Cmd+K", "terminal:Cmd+Shift+K"]
  }
}

{
  "id": "git",
  "name": "Git",
  "version": "2.1.0",
  "description": "Branch and changes per workspace and per terminal, a changes panel with stage, discard and commit (flat list or folder tree), a commit graph of the current, all or chosen branches, blame, and diffs of changed files.",
  "category": "scm",
  "capabilities": ["read-board"],
  "main": "main.js",
  "contributes": {
    "commands": [
      { "id": "show", "title": "Show Changes", "category": "Git", "capabilities": ["read-board"] },
      {
        "id": "show-graph",
        "title": "Show Graph",
        "category": "Git",
        "capabilities": ["read-board"]
      },
      {
        "id": "blame-file",
        "title": "Blame File",
        "category": "Git",
        "capabilities": ["read-board"]
      },
      {
        "id": "status",
        "title": "Branch, upstream and change counts (JSON)",
        "usage": "status",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "changes",
        "title": "Changed files: staged, unstaged, untracked (JSON)",
        "usage": "changes",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "diff",
        "title": "Unified diff of one changed file (JSON)",
        "usage": "diff <path> [--staged]",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "open",
        "title": "Open a changed file in the diff view",
        "usage": "open <path> [--staged]",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "log",
        "title": "Recent commits",
        "usage": "log [--limit <n>] [--json]",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "blame",
        "title": "Who last changed each line of a file",
        "usage": "blame <file> [--json]",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "stage",
        "title": "Stage paths",
        "usage": "stage <path...> | stage --all",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "unstage",
        "title": "Unstage paths",
        "usage": "unstage <path...> | unstage --all",
        "palette": false,
        "capabilities": ["read-board"]
      },
      {
        "id": "commit",
        "title": "Commit the staged changes",
        "usage": "commit -m <message>",
        "palette": false,
        "capabilities": ["read-board"]
      }
    ],
    "sidebarItems": true,
    "panel": { "title": "Git", "icon": "git-branch", "entry": "url" },
    "workspaceChips": [
      { "id": "branch", "title": "Git branch" },
      { "id": "diff-stats", "title": "Git diff stats" }
    ],
    "settings": {
      "pollSeconds": {
        "type": "number",
        "title": "Refresh interval",
        "default": 10,
        "minimum": 2,
        "maximum": 3600,
        "unit": "seconds",
        "description": "Time between git refreshes while {product} is focused"
      },
      "showDiffStats": {
        "type": "boolean",
        "title": "Diff stats on terminals",
        "default": true,
        "description": "Show the files changed and lines added and removed on each terminal"
      },
      "graphScope": {
        "type": "enum",
        "title": "Graph branches",
        "values": ["current", "all"],
        "valueTitles": { "current": "Current branch", "all": "All branches" },
        "default": "current",
        "description": "Branches the graph shows: the current branch, or all local and remote branches. Branches you choose in the panel for a repository take precedence"
      },
      "changesView": {
        "type": "enum",
        "title": "Changed files layout",
        "values": ["list", "tree"],
        "valueTitles": { "list": "List", "tree": "Folder tree" },
        "default": "list",
        "description": "Show changed files as a flat list or as a folder tree"
      }
    }
  }
}

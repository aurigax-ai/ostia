{
  "id": "lsp-pyright",
  "name": "Python (Pyright)",
  "version": "1.0.0",
  "locales": ["zh-Hant"],
  "api": "3.0",
  "description": "Python diagnostics, completion, hover and navigation in the editor. Ships Pyright inside this extension and runs it with {product}'s own runtime.",
  "category": "languages",
  "capabilities": ["language-server"],
  "contributes": {
    "settings": {
      "typeCheckingMode": {
        "type": "enum",
        "title": "Type checking",
        "values": ["off", "basic", "standard", "strict"],
        "valueTitles": {
          "off": "Off",
          "basic": "Basic",
          "standard": "Standard",
          "strict": "Strict"
        },
        "default": "standard",
        "description": "How strictly Pyright checks types. A pyrightconfig.json or pyproject.toml in the project wins"
      }
    },
    "languageServers": [
      {
        "id": "pyright",
        "name": "Pyright",
        "languages": ["python"],
        "run": {
          "node": "server/pyright/langserver.index.js",
          "args": ["--stdio"]
        },
        "rootMarkers": [
          "pyrightconfig.json",
          "pyproject.toml",
          "setup.py",
          "setup.cfg",
          "requirements.txt"
        ],
        "settings": {
          "python": { "analysis": { "typeCheckingMode": "standard" } }
        },
        "settingPaths": { "typeCheckingMode": "python.analysis.typeCheckingMode" }
      }
    ]
  }
}

{
  "$schema": "./node_modules/@aurigax-ai/ostia-extension-sdk/schemas/ostia.schema.json",
  "id": "hello",
  "name": "Hello",
  "version": "0.1.0",
  "api": "2.0",
  "description": "Starter extension: a command that greets you, and a skill and hook that teach coding agents to use it",
  "category": "other",
  "capabilities": ["notify", "agent-plugin"],
  "main": "main.js",
  "locales": ["zh-Hant"],
  "contributes": {
    "commands": [
      {
        "id": "greet",
        "title": "Hello: Greet",
        "category": "Hello",
        "argument": "Name",
        "usage": "greet <name>"
      },
      {
        "id": "agent-hook",
        "title": "Hello: Agent hook",
        "category": "Hello",
        "palette": false,
        "stdin": true
      }
    ],
    "agentSkills": [{ "name": "greet", "path": "skills/greet" }],
    "agentHooks": [{ "event": "SessionStart", "command": "agent-hook" }]
  }
}

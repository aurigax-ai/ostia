{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/cli/**/*",
    "src/extensions/**/*",
    "electron.vite.config.ts"
  ],
  "exclude": ["src/extensions/**/panel.ts"]
}

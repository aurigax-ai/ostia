{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"],
      "@aurigax-ai/pine-extension-sdk": ["src/extensions/sdk/index.ts"],
      "@aurigax-ai/pine-extension-sdk/assist": ["src/extensions/sdk/assist/index.ts"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/cli/**/*",
    "src/extensions/**/*",
    "electron.vite.config.ts"
  ],
  "exclude": ["src/extensions/**/panel.ts"]
}
